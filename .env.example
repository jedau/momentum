# --- Optional: local open-weight model via Ollama (Gemma by default) ---
# When Ollama isn't reachable the app silently falls back to heuristics.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT_MS=6000
MOMENTUM_DISABLE_LLM=0

# --- Optional: ElevenLabs voice (falls back to the browser voice when unset) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- Optional: where the JSON data store lives (defaults to ./data) ---
MOMENTUM_DATA_DIR=./data
